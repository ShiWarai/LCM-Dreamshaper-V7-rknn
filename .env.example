# docker compose reads variables from .env
# Host directory for models (mounted as /models in the container):
LCM_MODELS_DIR=
# Inside the container this is always /models (see docker-compose.yml)

# HTTP API port (OpenAI + MCP)
PORT=8765

# API key (OpenAI-style Bearer). If set — POST /v1/images/generations, /mcp, /images/* require
# Authorization: Bearer <your_key>
# DREAMSHAPER_API_KEY=sk-your-secret
# Multiple keys: key1,key2
# Alias for OpenAI SDK / clients:
# OPENAI_API_KEY=sk-your-secret

# Docker network for other services:
# docker network create dreamshaper_default
